doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title #{pageTitle}
    
    //- Favicon
    link(rel="shortcut icon", href="https://cdn.hstatic.net/1000281824/file/dspeed_3ba9cfa91c814cf3aeddcce42da0a1f8.png", type="image/png")
    
    //- Bootstrap 5 CSS
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css")
    
    //- FontAwesome 6
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css")
    
    //- SwiperJS CSS (Dùng cho slider banner trang chủ)
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css")
    
    //- Các file CSS custom của client
    link(rel="stylesheet", href="/client/css/footer.css")
    link(rel="stylesheet", href="/client/css/product.css")

    block style

  body
    //- Header chung
    include ../partials/header.pug

    //- Nội dung chính thay đổi theo từng trang
    block main

    //- Footer chung
    include ../partials/footer.pug

    //- JavaScript Libraries (Dùng chuẩn Bootstrap 5 Bundle bao gồm Popper)
    script(src="https://code.jquery.com/jquery-3.6.5.min.js")
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js")
    
    //- SwiperJS JS
    script(src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js")
    
    //- Lenis Smooth Scroll (Hiệu ứng cuộn mượt)
    script(src='https://unpkg.com/lenis@1.1.18/dist/lenis.min.js')
    
    //- Custom Script chính của bạn
    script(src="/client/js/script.js")
    
    script(src="/client/js/header.js")
    script(src="/client/js/favorites.js")
