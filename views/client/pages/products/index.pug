extends ../../layouts/default.pug
include ../../mixins/boxhead.pug
include ../../mixins/product-item.pug

block main
  .container.py-4
    .row
      .col-12.mb-4
        .box-header
          //- Sử dụng tiêu đề động (pageTitle từ Controller truyền sang)
          +box-header(pageTitle)

    .row
      if (products && products.length > 0)
        each item in products
          .col-md-3.col-6.mb-4
            +product-item(item)
      else
        .col-12
          .alert.alert-warning.text-center(role="alert")
            | Không tìm thấy sản phẩm nào trong danh mục này!