      .col-12.mb-4
        .box-header
          +box-header('Danh sách sản phẩm')

    .row
      //- Sản phẩm 1
      .col-md-4.col-6.mb-4
        .product-item
          .inner-image
            a(href='#')
              img(src='https://cdn.hstatic.net/products/1000281824/polowavekem6_9a00a37d7d2740e6a244b5cf776f6de3_large.png', alt='Áo POLO Degrey Heritage Racing')
