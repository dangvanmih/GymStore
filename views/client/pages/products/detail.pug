extends ../../layouts/default.pug
include ../../mixins/product-item.pug
include ../../mixins/alert.pug

block style
  link(rel="stylesheet" href="/client/css/detailProduct.css?v=1.1")

block main
  +alert-success(5000)
  .product-detail-page.py-4(data-variants=JSON.stringify(product.variants || []))
    .container
      //- Breadcrumb
      nav.custom-breadcrumb.mb-4(aria-label="breadcrumb")
        ol.breadcrumb.mb-0
          li.breadcrumb-item
            a(href="/") Trang chủ
          if product.category
            li.breadcrumb-item
              a(href=`/products/${product.category.slug}`)= product.category.title
          li.breadcrumb-item.active(aria-current="page")= product.title

      .row.g-4
        //- Cột trái: Ảnh
        .col-lg-6
          .product-image-container.position-relative.rounded.overflow-hidden
            if product.discountPercentage > 0
              span.badge-discount -#{product.discountPercentage}% OFF
            img.img-fluid.w-100.product-main-img(
              src=product.thumbnail
              alt=product.title
            )

        //- Cột phải: Thông tin
        .col-lg-6
          .product-info-wrapper.ps-lg-3
            h1.product-title.mb-3= product.title

            //- Giá bán
            .product-price-box.d-flex.align-items-center.mb-4
              if product.discountPercentage > 0
                span.badge-discount-text.mr-2 -#{product.discountPercentage}%
                if product.price
                  span.price-old.mr-2#product-price-old #{product.price.toLocaleString('vi-VN')}đ
                if product.priceNew
                  span.price-new#product-price-new #{product.priceNew.toLocaleString('vi-VN')}đ
              else
                if product.priceNew
                  span.price-new#product-price-new #{product.priceNew.toLocaleString('vi-VN')}đ
                else if product.price
                  span.price-new#product-price-new #{product.price.toLocaleString('vi-VN')}đ

            //- KIỂM TRA NẾU SẢN PHẨM CÓ BIẾN THỂ THÌ HIỂN THỊ MÀU VÀ SIZE TÁCH BIỆT
            if product.hasVariants && product.variants && product.variants.length > 0
              //- 1. Chọn Màu sắc
              - 
                const colors = [...new Set(product.variants.map(v => v.color).filter(c => c))];
              if colors.length > 0
                .product-variant-group.mb-3
                  label.fw-semibold.mb-2 Màu sắc:
                  .d-flex.flex-wrap.gap-2.color-list
                    each color, index in colors
                      button.btn.btn-outline-dark.color-item(
                        type="button"
                        data-color=color
                        class=(index === 0 ? "active btn-dark text-white" : "")
                      )= color

              //- 2. Chọn Kích thước (Size)
              - 
                const sizes = [...new Set(product.variants.map(v => v.size).filter(s => s))];
              if sizes.length > 0
                .product-variant-group.mb-4
                  label.fw-semibold.mb-2 Kích thước (Size):
                  .d-flex.flex-wrap.gap-2.size-list
                    each size, index in sizes
                      button.btn.btn-outline-dark.size-item(
                        type="button"
                        data-size=size
                        class=(index === 0 ? "active btn-dark text-white" : "")
                      )= size

            //- Số lượng & Nút
            form(
              action=`/cart/add/${product._id}`
              method="POST"
              class="mb-4"
            )
              //- Input ẩn để lưu thông tin màu và size người dùng chọn gửi lên giỏ hàng
              input(type="hidden" name="size" id="input-selected-size" value=product.hasVariants && product.variants[0] ? product.variants[0].size : "")
              input(type="hidden" name="color" id="input-selected-color" value=product.hasVariants && product.variants[0] ? product.variants[0].color : "")

              .d-flex.align-items-center.mr-3.mb-4
                .quantity-input-group.d-flex.align-items-center.mr-3
                  button.btn-qty(type="button" action-qty="minus") -
                  input.form-control.input-qty(
                    type="number"
                    name="quantity"
                    value="1"
                    min="1"
                    max=product.stock || 99
                  )
                  button.btn-qty(type="button" action-qty="plus") +

                button.btn.btn-chat-now.mr-3(type="button")
                  svg.mr-1(xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 18 18")
                    path(d="M8 0C3.58 0 0 3.356 0 7.5 0 9.882 1.156 12 2.96 13.435V16l2.457-1.35c.813.226 1.68.35 2.583.35 4.42 0 8-3.356 8-7.5S12.42 0 8 0zm.82 9.946-2.072-2.21-4.04 2.21 4.444-4.71 2.124 2.21 3.987-2.21-4.443 4.71z")
                  span Chat ngay

                button.btn.btn-add-cart(type="submit") THÊM VÀO GIỎ

            //- Khối chính sách
            .row.g-3.mb-4
              .col-6
                .policy-box.text-center.p-3
                  p.mb-0 Giao hàng toàn quốc
              .col-6
                .policy-box.text-center.p-3
                  p.mb-0 Đổi hàng chưa qua sử dụng trong vòng 30 ngày

            //- Accordion Thông tin thêm
            .product-accordion.accordion#productAccordion
              .accordion-item
                h2.accordion-header#headingDesc
                  button.accordion-button.collapsed(
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#collapseDesc"
                    aria-expanded="false"
                    aria-controls="collapseDesc"
                  )
                    span.fw-bold THÔNG TIN SẢN PHẨM
                    span.accordion-icon
                #collapseDesc.accordion-collapse.collapse(aria-labelledby="headingDesc" data-bs-parent="#productAccordion")
                  .accordion-body
                    if product.description
                      | !{product.description}
                    else
                      p Đang cập nhật thông tin sản phẩm...

              .accordion-item
                h2.accordion-header#headingShipping
                  button.accordion-button.collapsed(
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#collapseShipping"
                    aria-expanded="false"
                    aria-controls="collapseShipping"
                  )
                    span.fw-bold DỊCH VỤ GIAO HÀNG
                    span.accordion-icon
                #collapseShipping.accordion-collapse.collapse(aria-labelledby="headingShipping" data-bs-parent="#productAccordion")
                  .accordion-body
                    p Đơn hàng được giao hàng COD toàn quốc. Thời gian nhận hàng từ 2 - 4 ngày làm việc.

    if relatedProducts && relatedProducts.length > 0
      .container.py-5
        h2.fw-bold.text-uppercase.mb-4(style="font-size: 20px;") Sản phẩm liên quan
        .row
          each item in relatedProducts
            .col-md-3.col-6.mb-4
              +product-item(item)

  script(src="/client/js/product.js")
