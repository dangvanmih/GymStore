extends ../../layouts/default.pug

block style
  link(rel="stylesheet" href="/client/css/register.css?v=1.0")

block main
  .register-fullscreen-wrapper
    .row.g-0.min-vh-100
      .col-lg-6.d-none.d-lg-flex.position-relative.register-left-bg
        .register-overlay.d-flex.flex-column.justify-content-end.p-5.text-white.w-100
          h1.display-5.fw-bold.mb-3 Chào mừng trở lại GymStore
          p.lead.text-white-50 Đăng nhập để tiếp tục mua sắm, theo dõi giỏ hàng và lưu sản phẩm yêu thích.
      .col-12.col-lg-6.bg-white.d-flex.align-items-center.justify-content-center.p-4.p-md-5
        .register-form-container.w-100(style="max-width: 480px;")
          h2.fw-bold.mb-4.text-center Đăng nhập tài khoản
          form(action="/user/login" method="POST")
            .mb-3
              label.form-label.fw-semibold(for="email") Email
              input#email.form-control(type="email" name="email" placeholder="Nhập email của bạn" autocomplete="email" required)
            .mb-4
              label.form-label.fw-semibold(for="password") Mật khẩu
              input#password.form-control(type="password" name="password" placeholder="Nhập mật khẩu" autocomplete="current-password" required)
            .text-end.mb-3
              a.text-dark.small(href="/user/forgot-password") Quên mật khẩu?
            button.btn.btn-dark.w-100.py-3.fw-bold.mb-3(type="submit") Đăng nhập
            .text-center.text-muted.small
              | Bạn chưa có tài khoản? 
              a.text-dark.fw-semibold.text-decoration-none(href="/user/register") Đăng ký
