extends ../../layouts/default.pug
include ../../mixins/alert.pug

block style
  link(rel="stylesheet" href="/client/css/profile.css")

block main
  .account-page.py-4.py-lg-5
    .container
      +alert-success(5000)
      +alert-error(7000)
      .row.g-4.align-items-start
        .col-lg-3
          include ../../partials/account-sidebar.pug
        .col-lg-9
          section.account-content-card.account-password-card
            .account-page-heading
              div
                h1.h4.fw-bold.mb-1 Đổi mật khẩu
                p.text-muted.small.mb-0 Xác nhận mật khẩu hiện tại trước khi tạo mật khẩu mới.
            form(action="/user/profile/password" method="POST")
              .mb-3
                label.form-label(for="currentPassword") Mật khẩu hiện tại
                input#currentPassword.form-control(type="password" name="currentPassword" required autocomplete="current-password")
              .mb-3
                label.form-label(for="newPassword") Mật khẩu mới
                input#newPassword.form-control(type="password" name="newPassword" required minlength="8" autocomplete="new-password")
                .form-text Mật khẩu cần có ít nhất 8 ký tự.
              .mb-4
                label.form-label(for="confirmPassword") Nhập lại mật khẩu mới
                input#confirmPassword.form-control(type="password" name="confirmPassword" required minlength="8" autocomplete="new-password")
              button.btn.btn-success(type="submit") Cập nhật mật khẩu
