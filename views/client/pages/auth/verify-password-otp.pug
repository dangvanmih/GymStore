extends ../../layouts/default.pug
include ../../mixins/alert.pug

block style
  style.
    .reset-otp-page { min-height: 65vh; display: grid; place-items: center; background: #f4f4f4; padding: 48px 16px; }
    .reset-otp-card { width: min(100%, 420px); text-align: center; }
    .reset-otp-card h1 { font-size: 22px; font-weight: 700; color: #111827; margin-bottom: 10px; }
    .reset-otp-copy { color: #475569; margin-bottom: 20px; }
    .reset-otp-address { display: block; color: #111827; font-weight: 700; }
    .reset-otp-inputs { display: flex; justify-content: center; gap: 7px; margin: 20px 0; }
    .reset-otp-inputs input { width: 42px; height: 48px; border: 1px solid #111; border-radius: 10px; text-align: center; font-size: 22px; font-weight: 700; background: #fff; outline: none; }
    .reset-otp-inputs input:focus { box-shadow: 0 0 0 3px #1112; }
    .reset-otp-resend { color: #475569; margin: 0 0 18px; }
    .reset-otp-resend button { border: 0; padding: 0; background: transparent; color: #111827; font-weight: 600; }
    .reset-otp-resend button:disabled { color: #9ca3af; cursor: default; }
    .reset-otp-submit { width: 100%; border: 1px solid #111; border-radius: 10px; padding: 11px; color: white; background: #111; font-weight: 700; }
    .reset-otp-submit:disabled { border-color: #555; background: #555; color: #ddd; }
    .reset-otp-login { margin-top: 20px; color: #475569; }
    .reset-otp-login a { color: #111827; font-weight: 700; text-decoration: none; }

block main
  +alert-success(6000)
  +alert-error(6000)
  .reset-otp-page
    .reset-otp-card
      h1 Xác nhận đó là bạn
      p.reset-otp-copy
        | Nhập mã gồm 6 chữ số đã được gửi tới email
        strong.reset-otp-address= maskedEmail
      form#otpForm(action="/user/forgot-password/verify" method="POST")
        input#otpValue(type="hidden" name="otp")
        .reset-otp-inputs
          - for (let i = 0; i < 6; i++)
            input.otp-digit(type="text" inputmode="numeric" pattern="[0-9]" maxlength="1" aria-label=`Chữ số ${i + 1}` required autocomplete=(i === 0 ? "one-time-code" : "off"))
      p.reset-otp-resend
        | Chưa nhận được mã? 
        form#resendForm.d-inline(action="/user/forgot-password/resend" method="POST")
          button#resendButton(type="submit" disabled=resendIn > 0) Gửi lại mã
          |  
          span#countdown= resendIn > 0 ? `${resendIn}s` : ""
      button#verifyButton.reset-otp-submit(type="submit" form="otpForm" disabled) Xác nhận
      p.reset-otp-login
        | Đã xác minh tài khoản? 
        a(href="/user/login") Đăng nhập
  script.
    (() => {
      const boxes = [...document.querySelectorAll('.otp-digit')];
      const hidden = document.getElementById('otpValue');
      const submit = document.getElementById('verifyButton');
      const sync = () => {
        const value = boxes.map(box => box.value).join('');
        hidden.value = value;
        submit.disabled = value.length !== 6;
      };
      boxes.forEach((box, index) => {
        box.addEventListener('input', () => {
          box.value = box.value.replace(/\D/g, '').slice(-1);
          if (box.value && index < boxes.length - 1) boxes[index + 1].focus();
          sync();
        });
        box.addEventListener('keydown', event => {
          if (event.key === 'Backspace' && !box.value && index > 0) boxes[index - 1].focus();
        });
        box.addEventListener('paste', event => {
          const pasted = (event.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').slice(0, 6);
          if (!pasted) return;
          event.preventDefault();
          pasted.split('').forEach((digit, i) => { boxes[i].value = digit; });
          boxes[Math.min(pasted.length, boxes.length) - 1].focus();
          sync();
        });
      });
      let remaining = Number(document.getElementById('countdown').textContent.replace(/\D/g, '')) || 0;
      const resend = document.getElementById('resendButton');
      const countdown = document.getElementById('countdown');
      const tick = () => {
        if (remaining <= 0) { countdown.textContent = ''; resend.disabled = false; return; }
        countdown.textContent = `${remaining}s`;
        resend.disabled = true;
        remaining -= 1;
        window.setTimeout(tick, 1000);
      };
      if (remaining > 0) tick(); else resend.disabled = false;
      boxes[0].focus();
    })();
