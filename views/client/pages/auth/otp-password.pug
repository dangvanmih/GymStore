extends ../../layouts/default.pug

block style
  link(rel="stylesheet" href="/client/css/register.css?v=1.0")

block main
  .register-fullscreen-wrapper
    .row.g-0.min-vh-100
      
      //- CỘT TRÁI: Ảnh nền full nửa màn hình
      .col-lg-6.d-none.d-lg-flex.position-relative.register-left-bg
        .register-overlay.d-flex.flex-column.justify-content-end.p-5.text-white.w-100
          .mb-5
            h3.fw-bold.mb-2(style="font-size: 26px;") Xác thực tài khoản của bạn
            p.text-white-50.mb-0(style="font-size: 13.5px; max-width: 420px; line-height: 1.5;") Vui lòng kiểm tra hộp thư email để lấy mã xác thực gồm 6 chữ số và hoàn tất quá trình đăng ký.

      //- CỘT PHẢI: Form nhập OTP căn giữa
      .col-12.col-lg-6.bg-white.d-flex.align-items-center.justify-content-center.p-4.p-md-5
        .register-form-container.w-100(style="max-width: 440px;")
          h2.fw-bold.mb-3 Nhập mã OTP
          p.text-muted.small.mb-4
            | Mã xác thực đã được gửi tới email: 
            strong.text-dark #{email}

          //- Hiển thị thông báo lỗi / thành công (Flash message)
          include ../../mixins/alert.pug
          +alert-error()
          +alert-success()

          form(action="/user/otp-password" method="POST")
            //- Truyền ngầm email lên server
            input(type="hidden" name="email" value=email)

            .mb-4
              label.form-label.fw-semibold Mã xác thực (OTP)
              input.form-control.text-center.fw-bold.fs-4(type="text" name="otp" placeholder="_ _ _ _ _ _" maxlength="6" required style="letter-spacing: 8px;")

            button.btn.btn-dark.w-100.py-3.fw-bold.mb-3(type="submit") Xác thực

            .text-center.text-muted.small
              | Không nhận được mã? 
              a.text-dark.fw-semibold.text-decoration-underline(href="#") Gửi lại mã
