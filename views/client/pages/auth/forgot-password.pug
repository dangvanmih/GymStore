extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-success(6000)
  +alert-error(6000)
  .container.py-5(style="max-width: 520px; min-height: 55vh;")
    h1.h3.fw-bold.mb-2 Quên mật khẩu
    p.text-muted.mb-4 Nhập email tài khoản. Nếu email đã đăng ký, chúng tôi sẽ gửi mã OTP để xác thực đặt lại mật khẩu.
    form(action="/user/forgot-password" method="POST")
      .mb-3
        label.form-label(for="email") Email
        input#email.form-control(type="email" name="email" autocomplete="email" required)
      button.btn.btn-dark.w-100(type="submit") Gửi mã OTP
    p.mt-3.mb-0
      a(href="/user/login") Quay lại đăng nhập
