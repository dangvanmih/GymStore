extends ../../layouts/default.pug
include ../../mixins/alert.pug
include ../../mixins/breadcrumb.pug

block main
  +alert-success(3000)
  +alert-error(5000)
  .container.py-2.pb-5.mb-5(style="padding-bottom: 180px !important; margin-bottom: 100px !important;")
    +breadcrumb(pageTitle, [{ title: "Trang chủ", link: "/" }, { title: pageTitle }])
    if (cartDetail && cartDetail.products && cartDetail.products.length > 0)
        .row
          //- Cột danh sách sản phẩm
          .col-lg-8
            .table-responsive
              table.table.align-middle.mb-0
                thead.table-light
                  tr.text-center 
                    th(scope="col") STT 
                    th(scope="col" style="width: 100px;") Hình ảnh
                    th(scope="col") Tên sản phẩm
                    th(scope="col") Đơn giá
                    th(scope="col" style="width: 120px;") Số lượng
                    th(scope="col" style="width: 100px") Thành tiền
                    th(scope="col" style="width: 100px;") Thao tác
                tbody
                  each item, index in cartDetail.products
                    if item.productInfo
                      tr.cart-item-row(data-product-id=item.product_id data-size=item.size data-color=item.color)
                        td.text-center #{index + 1}
                        td.text-center
                          img.img-fluid.rounded(src=item.productInfo.thumbnail alt=item.productInfo.title style="width: 80px; height: 80px; object-fit: cover;")
                        td
                          h5.fs-6.mb-1.cart-product-title
                            a.text-dark.text-decoration-none(href=`/products/detail/${item.productInfo.slug}`) #{item.productInfo.title}
                          if item.size || item.color
                            p.text-muted.small.mb-0 
                              if item.color
                                | Màu: #{item.color} 
                              if item.size
                                | | Size: #{item.size}
                        td.text-center
                          span.fw-semibold #{Number(item.price || 0).toLocaleString('vi-VN')}đ
                          if item.priceOld > item.price
                            br
                            span.text-muted.text-decoration-line-through.small #{Number(item.priceOld).toLocaleString('vi-VN')}đ
                        td.text-center
                          .input-group.input-group-sm.cart-quantity-control(style="max-width: 120px")
                            button.btn.btn-quantity(type="button" data-action="decrease" aria-label="Giảm số lượng") −
                            input.form-control.input-quantity(
                              type="number"
                              value=item.quantity
                              min="1"
                              max=(item.stock || 99)
                              product-id=item.product_id
                            )
                            button.btn.btn-quantity(type="button" data-action="increase" aria-label="Tăng số lượng") +
                        td.text-center
                          span.fw-bold.text-danger.item-total-price #{Number(item.totalPrice || 0).toLocaleString('vi-VN')}đ
                        td.text-center
                          a.btn.btn-sm.btn-delete-item(href=`/cart/delete/${item.product_id}` aria-label="Xóa sản phẩm" title="Xóa sản phẩm")
                            i.fa-solid.fa-trash-can(aria-hidden="true")
                    else
                      tr
                        td.text-center #{index + 1}
                        td.text-center(colspan="6").text-muted Sản phẩm này không còn khả dụng.
                        td.text-center
                          span.text-danger Không khả dụng

          //- Cột tổng tiền & Thanh toán
          .col-lg-4
            .card.shadow-sm.border-0
              .card-body
                h4.card-title.fs-5.mb-3 Cộng giỏ hàng
                .d-flex.justify-content-between.mb-2
                  span Tạm tính:
                  span.fw-semibold.cart-total-all #{Number(cartDetail.totalAll || 0).toLocaleString('vi-VN')}đ
                .d-flex.justify-content-between.mb-3.border-bottom.pb-3
                  span Phí vận chuyển:
                  span Miễn phí
                .d-flex.justify-content-between.mb-4
                  span.fw-bold Tổng cộng:
                  span.fw-bold.text-danger.fs-5.cart-total-all #{Number(cartDetail.totalAll || 0).toLocaleString('vi-VN')}đ
                a.btn.btn-dark.w-100.py-2(href="/checkout") Tiến hành thanh toán
    else
      .row
        .col-12.text-center.py-5
          .cart-empty-icon.mb-3
            svg(xmlns="http://www.w3.org/2000/svg" width="84" height="84" fill="currentColor" class="bi bi-cartX text-muted" viewBox="0 0 16 16")
              path(d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5zM3.102 4l1.313 7h8.17l1.313-7H3.102zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2z")
          p.fs-5.text-muted.mb-2 Giỏ hàng của bạn đang trống!
          p.text-secondary.small.mb-3 Không có sản phẩm nào trong giỏ hàng của bạn.
          a.btn.btn-dark.px-4.py-2.mt-2(href="/products") Tiếp tục mua sắm

  script(src="/client/js/cart.js")

