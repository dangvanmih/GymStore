mixin product-item(item)
  - const itemOutOfStock = item.hasVariants ? !(item.variants || []).some(variant => Number(variant.stock) > 0) : !(Number(item.stock) > 0);
  .product-item(class=(itemOutOfStock ? "is-out-of-stock" : ""))
    .inner-image
      a(href=`/products/detail/${item.slug}`)
        img(src=item.thumbnail, alt=item.title)
      if itemOutOfStock
        span.out-of-stock-badge Tạm hết hàng
      form.favorite-toggle(action=`/favorites/toggle/${item._id}`, method="POST" data-favorite-form data-product-id=String(item._id))
        button.favorite-toggle-button(type="submit" aria-label=(favoriteIds && favoriteIds.includes(String(item._id)) ? "Xóa khỏi yêu thích" : "Thêm vào yêu thích") title=(favoriteIds && favoriteIds.includes(String(item._id)) ? "Xóa khỏi yêu thích" : "Thêm vào yêu thích"))
          i(class=(favoriteIds && favoriteIds.includes(String(item._id)) ? "fa-solid fa-heart" : "fa-regular fa-heart"))
      if (!itemOutOfStock && item.discountPercentage > 0)
        .inner-discount -#{item.discountPercentage}%
    .inner-content
      h3.inner-title
        a(href=`/products/detail/${item.slug}`) #{item.title}
      .inner-price
        span.inner-price-new #{item.priceNew.toLocaleString('vi-VN')}₫
        if (item.price && item.price > item.priceNew)
          span.inner-price-old #{item.price.toLocaleString('vi-VN')}₫
