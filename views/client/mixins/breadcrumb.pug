mixin breadcrumb(title, links)
  .client-page-heading.mb-4
    div
      nav(aria-label="breadcrumb")
        ol.breadcrumb.bg-transparent.p-0.mb-2.small
          each item, index in links
            if index === links.length - 1
              //- Mục cuối cùng (trang hiện tại)
              li.breadcrumb-item.active.text-dark.fw-semibold(aria-current="page") #{item.title}
            else
              //- Các mục trước có gắn link
              li.breadcrumb-item
                a.breadcrumb-link(href=item.link) #{item.title}
      h1.h3.mb-0.text-gray-800 #{title}
