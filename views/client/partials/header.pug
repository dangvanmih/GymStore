link(rel="stylesheet", href="/client/css/header.css")
header.header.bg-white.sticky-top
  .container
    .row.align-items-center.py-2
      //- Logo
      .col-lg-2.col-6
        a.d-inline-block(href='/')
          img(src=(siteSettings && siteSettings.clientLogo) || '/client/images/logo.webp', alt='Logo', style='height:60px; object-fit: contain;')

      //- Liên kết điều hướng
      .col-lg-7.d-none.d-lg-block
        nav.navbar.navbar-expand-lg.p-0
          ul.navbar-nav.mx-auto.align-items-center
            if (layoutCategories)
              each item in layoutCategories
                if (item.children && item.children.length > 0)
                  //- Danh mục cha có danh mục con (hiển thị menu khi rê chuột)
                  li.nav-item.dropdown.custom-dropdown
                    span.nav-link.custom-nav-link.d-flex.align-items-center(
                      style="cursor: pointer;",
                      onclick=`window.location.href='/products/${item.slug}'`
                    ) #{item.title}
                      i.fa-solid.fa-chevron-down.custom-arrow.ms-2
                    ul.dropdown-menu.custom-dropdown-menu
                      each sub in item.children
                        li: a.dropdown-item(href=`/products/${sub.slug}`) #{sub.title}
                else
                  //- Danh mục không có danh mục con
                  li.nav-item
                    a.nav-link.custom-nav-link(href=`/products/${item.slug}`) #{item.title}

            //- Liên kết cố định
            li.nav-item: a.nav-link.custom-nav-link(href='/cua-hang') Cửa hàng
            li.nav-item: a.nav-link.custom-nav-link(href='/orders') Tra cứu đơn hàng

      //- Các tiện ích
      .col-lg-3.col-6.d-flex.align-items-center.justify-content-end
        button#btnMobileMenu.mobile-menu-toggle.d-lg-none(type='button', aria-label='Mở menu', aria-expanded='false', aria-controls='mobileNavigation')
          i.fa-solid.fa-bars(aria-hidden='true')

        //- Nút mở khung tìm kiếm
        button#btnOpenSearch.icon-link.btn.btn-link.mr-3(type='button', title='Tìm kiếm')
          i.fas.fa-search

        //- Menu tài khoản
        .nav-icon-item.dropdown.user-dropdown.mr-3
          a.icon-link(href='#', id='userDropdown', data-toggle='dropdown', aria-label='Tài khoản')
            i.far.fa-user
          .dropdown-menu.dropdown-menu-right.shadow-sm.border-0
            .px-3.py-2.border-bottom.small.text-muted TÀI KHOẢN
            if currentUser
              .dropdown-item-text.py-2 #{currentUser.firstName || ''} #{currentUser.lastName || ''}
              a.dropdown-item.py-2(href='/user/profile')
                i.fas.fa-id-card.me-2
                span Hồ sơ của tôi
              a.dropdown-item.py-2(href='/user/logout')
                i.fas.fa-sign-out-alt.me-2
                span Đăng xuất
            else
              a.dropdown-item.py-2(href='/user/login')
                i.fas.fa-sign-in-alt.me-2
                span Đăng nhập
              a.dropdown-item.py-2(href='/user/register')
                i.fas.fa-user-plus.me-2
                span Đăng ký

        a.nav-icon-item.icon-link.favorite-link.mr-3(href='/favorites' aria-label='Sản phẩm yêu thích' title='Sản phẩm yêu thích')
          i.fa-regular.fa-heart
          if favoriteCount > 0
            span.favorite-badge #{favoriteCount}

        //- Giỏ hàng
        a.nav-icon-item.icon-link.cart-link.mr-3(href='/cart' aria-label='Giỏ hàng' title='Giỏ hàng')
          i.fas.fa-shopping-bag
          span.cart-badge #{miniCart ? miniCart.totalQuantity : 0}

    #mobileNavigation.mobile-navigation.d-lg-none(aria-hidden='true')
      nav(aria-label='Menu chính')
        ul.mobile-navigation-list
          if (layoutCategories)
            each item in layoutCategories
              li.mobile-navigation-item
                a.mobile-navigation-link(href=`/products/${item.slug}`) #{item.title}
                if (item.children && item.children.length > 0)
                  ul.mobile-subnavigation
                    each sub in item.children
                      li: a.mobile-navigation-sublink(href=`/products/${sub.slug}`) #{sub.title}
          li.mobile-navigation-item: a.mobile-navigation-link(href='/cua-hang') Cửa hàng
          li.mobile-navigation-item: a.mobile-navigation-link(href='/orders') Tra cứu đơn hàng

//- Khung tìm kiếm toàn màn hình
#searchOverlay.search-overlay
  .search-overlay-content.bg-white.py-4
    .container.position-relative
      //- Nút đóng
      button#btnCloseSearch.btn-close-search(type='button', aria-label='Đóng tìm kiếm')
        i.fas.fa-times

      .row.justify-content-center.align-items-center.mb-2
        .col-md-2.text-center.text-md-left.mb-3.mb-md-0
          a(href='/')
            img(src=(siteSettings && siteSettings.clientLogo) || '/client/images/logo.webp', alt='Logo', style='height: 60px; object-fit: contain;')

        .col-md-8.position-relative
          form(action='/products/search', method='GET')
            .search-input-wrapper
              i.fas.fa-search.search-icon-inside
              input#searchInput.search-input-overlay(type='text', name='q', placeholder='Tìm kiếm sản phẩm...', autocomplete='off')

          //- Kết quả tìm kiếm
          #search-results.search-results-container(style="display: none;")

          //- Gợi ý tìm kiếm
          #searchSuggestionsBlock.search-suggestions.mt-3
            span.text-muted.small.mr-2 Gợi ý cho bạn:
            a.suggestion-link(href='/products') Tất cả sản phẩm
            span.divider |
            a.suggestion-link(href='/products/phu-kien') PHỤ KIỆN
