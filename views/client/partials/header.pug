link(rel="stylesheet", href="/client/css/header.css")
header.header.border-bottom.bg-white.sticky-top
  .container
    .row.align-items-center.py-2
      //- Logo
      .col-lg-2.col-6
        a.d-inline-block(href='/')
          img(src='/client/images/logo.webp', alt='Logo', style='height:60px; object-fit: contain;')

      //- Navigation Links
      .col-lg-7.d-none.d-lg-block
        nav.navbar.navbar-expand-lg.p-0
          ul.navbar-nav.mx-auto.align-items-center
            if (layoutCategories)
              each item in layoutCategories
                if (item.children && item.children.length > 0)
                  //- Danh mục cha có danh mục con (Hiển thị Dropdown hover)
                  li.nav-item.dropdown.custom-dropdown
                    span.nav-link.custom-nav-link.d-flex.align-items-center(
                      style="cursor: pointer;",
                      onclick=`window.location.href='/products/${item.slug}'`
                    ) #{item.title}
                      i.fa-solid.fa-chevron-down.custom-arrow.ms-2
                    ul.dropdown-menu.custom-dropdown-menu
                      each sub in item.children
                        li: a.dropdown-item(href=`/products/${sub.slug}`) #{sub.title}
                else
                  //- Danh mục độc lập không có con
                  li.nav-item
                    a.nav-link.custom-nav-link(href=`/products/${item.slug}`) #{item.title}

            //- Các link tĩnh
            li.nav-item: a.nav-link.custom-nav-link(href='/cua-hang') Cửa hàng
            li.nav-item: a.nav-link.custom-nav-link(href='/kiem-tra-don-hang') Tra cứu đơn

      //- Action Utilities
      .col-lg-3.col-6.d-flex.align-items-center.justify-content-end
        //- Nút kính hiển vi kích hoạt Search Overlay
        button#btnOpenSearch.icon-link.btn.btn-link.mr-3(type='button', title='Tìm kiếm')
          i.fas.fa-search

        //- Account Dropdown
        .nav-icon-item.dropdown.user-dropdown.mr-3
          a.icon-link(href='#', id='userDropdown', data-toggle='dropdown')
            i.far.fa-user
          .dropdown-menu.dropdown-menu-right.shadow-sm.border-0
            .px-3.py-2.border-bottom.small.text-muted TÀI KHOẢN
            a.dropdown-item.py-2(href='/login')
              i.fas.fa-sign-in-alt.mr-2
              | Đăng nhập
            a.dropdown-item.py-2(href='/register')
              i.fas.fa-user-plus.mr-2
              | Đăng ký

        //- Shopping Cart
        a.nav-icon-item.icon-link.cart-link.mr-3(href='/cart')
          i.fas.fa-shopping-bag
          span.cart-badge 3

        //- Language Switcher
        .nav-icon-item.dropdown.lang-dropdown
          a.icon-link.dropdown-toggle.no-caret(href='#', id='langDropdown', data-toggle='dropdown')
            img.flag-icon(src='https://flagcdn.com/w40/vn.png', alt='VN')
          .dropdown-menu.dropdown-menu-right.shadow-sm.border-0.min-vw-0(style='min-width: 110px;')
            a.dropdown-item.d-flex.align-items-center.py-2(href='?lang=vi')
              img.flag-icon.mr-2(src='https://flagcdn.com/w40/vn.png', alt='VN')
              span.small.font-weight-bold VN
            a.dropdown-item.d-flex.align-items-center.py-2(href='?lang=en')
              img.flag-icon.mr-2(src='https://flagcdn.com/w40/gb.png', alt='EN')
              span.small.font-weight-bold EN


//- SEARCH OVERLAY (Khung tìm kiếm phủ toàn màn hình)
#searchOverlay.search-overlay
  .search-overlay-content.bg-white.py-4
    .container.position-relative
      //- Nút đóng (Dấu X)
      button#btnCloseSearch.btn-close-search(type='button')
        i.fas.fa-times

      .row.justify-content-center.align-items-center.mb-2
        .col-md-2.text-center.text-md-left.mb-3.mb-md-0
          a(href='/')
            img(src='/client/images/logo.webp', alt='Logo', style='height: 60px; object-fit: contain;')
        
        .col-md-8.position-relative
          form(action='/products/search', method='GET')
            .search-input-wrapper
              i.fas.fa-search.search-icon-inside
              input#searchInput.search-input-overlay(type='text', name='q', placeholder='Tìm kiếm sản phẩm...', autocomplete='off')

          //- Đặt khung kết quả ở đây để nó có cùng độ rộng với col-md-8
          #search-results.search-results-container(data-lenis-prevent, style="display: none;")
          
          //- Khối Gợi ý từ khóa
          #searchSuggestionsBlock.search-suggestions.mt-3
            span.text-muted.small.mr-2 Gợi ý cho bạn:
            a.suggestion-link(href='/products') Tất cả sản phẩm
            span.divider |
            a.suggestion-link(href='/products/phu-kien') PHỤ KIỆN
