mixin search(keyword)
  form#form-search.search-form
    .input-group
      input.form-control.form-control-sm.search-input(
        type="text", 
        name="keyword", 
        placeholder="Tìm kiếm sản phẩm...", 
        value=keyword
      )
      button.btn.btn-sm.btn-search(type="submit")
        i.fas.fa-search