mixin table-tree(category, level = 1)
  each items, index in category
    - const prefix = Array(level + 1).join("-- ")
    tr
      td.text-center
        input(type="checkbox" name="id" value=items.id)
      td.text-center.fw-medium.text-secondary #{items.index}
      td
        .fw-semibold.text-dark.product-title #{prefix}#{items.title}
        small.text-muted.d-block ID: #{items._id || 'PROD-' + (items.index)}
      td.text-center 
        input.form-control.form-control-sm.input-position-dark(
          type="number"
          value=items.position
          min="1"
          name="position"
          data-id=items._id
        )
      td.text-center
        if items.status == 'active'
          a.badge-status.badge-status-success.text-decoration-none(
            href="javascript:;"
            data-id=items.id
            data-status=items.status
            button-change-status
          )
            i.fas.fa-circle
            | Hoạt động
        else
          a.badge-status.badge-status-danger.text-decoration-none(
            href="javascript:;"
            data-id=items.id
            data-status=items.status
            button-change-status
          )
            i.fas.fa-circle
            | Dừng hoạt động
      td.text-center
        .action-btn-group
          if(role.permissions.includes("products-category_edit"))
            a.btn-action.btn-action-edit(href=`${prefixAdmin}/categories/edit/${items.id}`, title="Chỉnh sửa")
              i.fas.fa-pen
          a.btn-action.btn-action-detail(
            href=`${prefixAdmin}/categories/detail/${items.id}`
            title="Xem chi tiết"
          )
            i.fas.fa-eye
          if(role.permissions.includes("products-category_delete"))
            button(class= "btn-action btn-action-delete" data-id = items.id button-delete title="Xóa danh mục")
              i.fas.fa-trash-alt
    if items.children && items.children.length > 0
      +table-tree(items.children, level + 1)
