extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-error(5000)
  .container-fluid.p-0
    .d-flex.justify-content-between.align-items-center.mb-4
      div
        h1.h3.mb-1= isEdit ? "Sửa nhà cung cấp" : "Thêm nhà cung cấp"
        p.text-muted.mb-0 Nhập thông tin liên hệ của nhà cung cấp.
      a.btn.btn-outline-secondary(href=`${prefixAdmin}/suppliers`)
        i.fas.fa-arrow-left.me-2
        | Quay lại
    .card.border-0.shadow-sm
      .card-body
        form(action=formAction method="POST")
          .row.g-3
            .col-md-6
              label.form-label(for="name") Tên nhà cung cấp #[span.text-danger *]
              input#name.form-control(type="text" name="name" required maxlength="150" value=(supplier ? supplier.name : ""))
            .col-md-6
              label.form-label(for="contactName") Người liên hệ
              input#contactName.form-control(type="text" name="contactName" maxlength="150" value=(supplier ? supplier.contactName : ""))
            .col-md-6
              label.form-label(for="phone") Điện thoại
              input#phone.form-control(type="tel" name="phone" maxlength="40" value=(supplier ? supplier.phone : ""))
            .col-md-6
              label.form-label(for="email") Email
              input#email.form-control(type="email" name="email" maxlength="200" value=(supplier ? supplier.email : ""))
            .col-12
              label.form-label(for="address") Địa chỉ
              input#address.form-control(type="text" name="address" maxlength="300" value=(supplier ? supplier.address : ""))
            .col-12
              label.form-label(for="description") Ghi chú
              textarea#description.form-control(name="description" rows="3")= supplier ? supplier.description : ""
            if isEdit
              .col-md-6
                label.form-label(for="status") Trạng thái
                select#status.form-select(name="status")
                  option(value="active" selected=supplier.status === "active") Hoạt động
                  option(value="inactive" selected=supplier.status === "inactive") Ngừng hoạt động
          .d-flex.justify-content-end.gap-2.mt-4
            a.btn.btn-light(href=`${prefixAdmin}/suppliers`) Hủy
            button.btn.btn-custom(type="submit")= isEdit ? "Lưu thay đổi" : "Tạo nhà cung cấp"
