extends ../../layouts/default.pug
include ../../mixins/alert.pug

append style
  link(rel="stylesheet" href="/admin/css/permission.css")

block main
  if(role.permissions.includes("roles_permission"))
    +alert-success(5000)
    .permissions-wrapper.container-fluid.py-4
      .d-flex.align-items-center.justify-content-between.mb-4.flex-wrap.gap-3
        div
          h1.page-title.mb-1 Phân quyền
          p.permission-description.mb-0
            | Quản lý quyền truy cập và thao tác theo từng nhóm quyền.

        button.btn.btn-update-permissions(
          type="submit"
          button-submit
        )
          i.fas.fa-save.me-2
          | Cập nhật

      div(data-records=records)

      if records
        .card.card-dark.border-0.shadow-sm.mb-3
          .card-header.card-header-dark.d-flex.align-items-center.justify-content-between.py-3
            div
              span.fw-bold.text-light Danh sách nhóm quyền
              p.permission-card-description.mb-0
                | Tích chọn các thao tác được phép thực hiện cho từng nhóm.

          .card-body.p-0
            .table-responsive
              table.table.table-dark.table-hover.table-bordered.align-middle.mb-0(table-permissions)
                thead
                  //- Hàng chứa ID ẩn
                  tr(data-name="id" class="d-none")
                    td
                    each item in records
                      td.text-center
                        input(type="text" value=item.id)

                  //- Hàng tiêu đề hiển thị Title nhóm quyền
                  tr
                    th.permission-feature-col Tính năng
                    each item in records
                      th.text-center.permission-role-col #{item.title}

                tbody
                  //- Nhóm: Danh mục sản phẩm
                  tr.table-group-header
                    td(colspan=records.length + 1)
                      b Danh mục sản phẩm
                  
                  - 
                    const listPermissions = [
                      { name: "products-category_view", label: "Xem" },
                      { name: "products-category_create", label: "Thêm mới" },
                      { name: "products-category_edit", label: "Sửa" },
                      { name: "products-category_delete", label: "Xóa" }
                    ]

                  each perm in listPermissions
                    tr(data-name=perm.name)
                      td.ps-4 #{perm.label}
                      each item in records
                        td.text-center
                          input.form-check-input.checkbox-dark(
                            type="checkbox" 
                            disabled=(item.title.toLowerCase() === "quản trị viên" || item.title.toLowerCase() === "admin")
                          )

                  //- Nhóm: Sản phẩm
                  tr.table-group-header
                    td(colspan=records.length + 1)
                      b Sản phẩm
                  
                  - 
                    const listProductPerms = [
                      { name: "products_view", label: "Xem" },
                      { name: "products_create", label: "Thêm mới" },
                      { name: "products_edit", label: "Sửa" },
                      { name: "products_delete", label: "Xóa" }
                    ]

                  each perm in listProductPerms
                    tr(data-name=perm.name)
                      td.ps-4 #{perm.label}
                      each item in records
                        td.text-center
                          input.form-check-input.checkbox-dark(
                            type="checkbox" 
                            disabled=(item.title.toLowerCase() === "quản trị viên" || item.title.toLowerCase() === "admin")
                          )

                  //- Nhóm: Nhóm quyền
                  tr.table-group-header
                    td(colspan=records.length + 1)
                      b Nhóm quyền
                  
                  - 
                    const listRolePerms = [
                      { name: "roles_view", label: "Xem" },
                      { name: "roles_create", label: "Thêm mới" },
                      { name: "roles_edit", label: "Sửa" },
                      { name: "roles_delete", label: "Xóa" },
                      { name: "roles_permission", label: "Phân quyền" }
                    ]

                  each perm in listRolePerms
                    tr(data-name=perm.name)
                      td.ps-4 #{perm.label}
                      each item in records
                        td.text-center
                          input.form-check-input.checkbox-dark(
                            type="checkbox" 
                            disabled=(item.title.toLowerCase() === "quản trị viên" || item.title.toLowerCase() === "admin")
                          )

                  //- Nhóm: Tài khoản
                  tr.table-group-header
                    td(colspan=records.length + 1)
                      b Tài khoản
                  
                  - 
                    const listAccountPerms = [
                      { name: "accounts-view", label: "Xem" },
                      { name: "accounts-view_create", label: "Thêm mới" },
                      { name: "accounts-view_edit", label: "Sửa" },
                      { name: "accounts-view_delete", label: "Xóa" }
                    ]

                  each perm in listAccountPerms
                    tr(data-name=perm.name)
                      td.ps-4 #{perm.label}
                      each item in records
                        td.text-center
                          input.form-check-input.checkbox-dark(
                            type="checkbox" 
                            disabled=(item.title.toLowerCase() === "quản trị viên" || item.title.toLowerCase() === "admin")
                          )

      form(
        id="form-change-permissions"
        method="POST"
        action=`${prefixAdmin}/roles/permissions?_method=PATCH`
        class="d-none"
      ) 
        div(class="form-group")
          input(type="text" class="form-control" name="permissions")    

      script(src="/admin/js/role.js")