extends ../../layouts/default.pug
include ../../mixins/alert.pug

append style
  link(rel="stylesheet" href="/admin/css/role-create.css")

block main
  if(role.permissions.includes("roles_view"))
    +alert-success(5000)
    +alert-error(5000)
    .roles-create-wrapper.container-fluid.py-4
      .d-flex.justify-content-between.align-items-center.mb-4
        div
          h1.page-title.mb-1 Chi tiết vai trò
          p.text-muted.mb-0 Thông tin và quyền được cấp cho vai trò.
        .d-flex.gap-2
          a.btn.btn-secondary(href=`${prefixAdmin}/roles`)
            i.fas.fa-arrow-left.mr-2
            | Quay lại
          if(role.permissions.includes("roles_edit"))
            a.btn.btn-submit-role(href=`${prefixAdmin}/roles/edit/${roleDetail.id}`)
              i.fas.fa-edit.mr-2
              | Chỉnh sửa
      .row.justify-content-center
        .col-lg-9
          .card.card-dark.border-0.shadow-sm.mb-4
            .card-body.p-4
              h3.text-light #{roleDetail.title}
              p.text-muted.mb-3 !{roleDetail.description || 'Chưa có mô tả'}
              p.mb-0
                strong.text-light Số tài khoản được gán: 
                span.text-muted #{accountCount}
          .card.card-dark.border-0.shadow-sm
            .card-header Danh sách quyền
            .card-body
              if(roleDetail.permissions && roleDetail.permissions.length)
                .d-flex.flex-wrap.gap-2
                  each permission in roleDetail.permissions
                    span.badge.badge-info.py-2.px-3 #{permission}
              else
                p.text-muted.mb-0 Vai trò này chưa được cấp quyền nào.
