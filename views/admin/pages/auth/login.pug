extends ../../layouts/auth.pug
include ../../mixins/alert.pug

block main
  +alert-success(3000)
  +alert-error(3000)

  main.login-page
    section.login-card(aria-labelledby="login-title")
      a.brand(href="/" aria-label="DEGREY - Trang chủ")
        img(src="/admin/images/logo-web.png" alt="" width="40" height="40")
        span DEGREY

      p.login-eyebrow QUẢN TRỊ HỆ THỐNG
      h1#login-title Chào mừng bạn trở lại
      p.login-description Đăng nhập để tiếp tục quản lý hệ thống cửa hàng.

      form(action=`${prefixAdmin}/auth/login` method="POST")
        .form-group
          label(for="email") Email
          .input-field
            i.far.fa-envelope(aria-hidden="true")
            input#email.form-control(
              type="email"
              name="email"
              placeholder="Email của bạn"
              autocomplete="username"
              required
            )

        .form-group
          label(for="password") Mật khẩu
          .input-field.password-field
            i.fas.fa-lock(aria-hidden="true")
            input#password.form-control(
              type="password"
              name="password"
              placeholder="Nhập mật khẩu"
              autocomplete="current-password"
              required
            )
            button.toggle-password(
              type="button"
              aria-label="Hiện mật khẩu"
              data-toggle-password
            )
              i.far.fa-eye(aria-hidden="true")

        button.btn-login(type="submit") Đăng nhập
