extends ../../layouts/default.pug
include ../../mixins/filterStatus.pug
include ../../mixins/search.pug
include ../../mixins/pagination.pug
include ../../mixins/form-change-multi.pug
include ../../mixins/alert.pug
include ../../mixins/sort.pug
include ../../mixins/breadcrumb.pug
append style
  link(rel="stylesheet" href="/admin/css/product.css")

block main
  if(role.permissions.includes("products_view"))
    +alert-success(3000)
    +alert-error(3000)

    .container-fluid.p-0
      +breadcrumb("Danh sách sản phẩm", [
        { title: "Dashboard", link: `${prefixAdmin}/dashboard` },
        { title: "Sản phẩm", link: "#" }
      ])

      .d-flex.justify-content-between.align-items-center.mb-3
        p.text-muted.mb-0 Quản lý sản phẩm, giá bán và trạng thái sản phẩm.
        
        if(role.permissions.includes("products_create"))
          a.btn.btn-custom.btn-sm.d-inline-flex.align-items-center(href=`${prefixAdmin}/products/create`)
            i.fas.fa-plus.mr-2
            span Thêm sản phẩm

      //- Wrapper Card cho bảng
      .card.mb-3 
        .card-header Bộ lọc và tìm kiếm 
        .cpn-search-filter.card-body
          .row.align-items-center
            .col-md-4.col-lg-3
              +filter-Status(filterStatus)
            .col-md-3.col-lg-3
              +form-change-multi(`${prefixAdmin}/products/change-multi?_method=PATCH`)
            .col-md-3.col-lg-3
              +sort()
            .col-md-2.col-lg-3
              +search(keyword)
      .card.border-0.shadow-sm.rounded-3
        .card-body.p-0
          .table-responsive
            table(
              class = "tabletable-hover align-middle mb-0 custom-enterprise-table"
              checkbox-multi
            )
              thead
                tr
                  th.text-center
                    input(type="checkbox" name="checkall")
                  th.text-center(style="width: 60px;") STT
                  th(style="width: 100px;") Hình ảnh
                  th Tiêu đề sản phẩm
                  th.text-end(style="width: 140px;") Giá bán
                  th.text-center(style = "width: 140px") Vị trí
                  th.text-center(style="width: 150px;") Trạng thái
                  th.text-center(style="width: 130px;") Thao tác
              tbody
                if (products && products.length > 0)
                  each items, index in products
                    tr
                      td.text-center
                        input(type="checkbox" name="id" value=items.id)
                      td.text-center.fw-medium.text-secondary #{pagination.limitItems*(pagination.currentPage - 1) + (index + 1)}
                      td
                        .product-img-wrapper
                          img.product-img(src=items.thumbnail alt=items.title)
                      td
                        .fw-semibold.text-dark.product-title #{items.title}
                        small.text-muted.d-block ID: #{items._id || 'PROD-' + (index + 1)}
                      td.text-end
                        span.fw-bold
                          if items.hasVariants && items.variants && items.variants.length > 0
                            //- Lấy giá của biến thể đầu tiên (hoặc giá của size S nếu nó nằm đầu)
                            - var displayPrice = items.variants[0].priceNew > 0 ? items.variants[0].priceNew : items.variants[0].price;
                            = `${Number(displayPrice).toLocaleString('vi-VN')} đ`
                          else
                            //- Nếu không có biến thể thì hiển thị giá chung của sản phẩm
                            - var defaultPrice = items.priceNew > 0 ? items.priceNew : items.price;
                            = `${Number(defaultPrice).toLocaleString('vi-VN')} đ`
                      td.text-center 
                        input.form-control.form-control-sm.input-position-dark(
                          type="number"
                          value=items.position
                          min="1"
                          name="position"
                          data-id=items._id
                        )
                      td.text-center
                        if items.status == 'active'
                          a.badge-status.badge-status-success.text-decoration-none(
                            href="javascript:;"
                            data-id=items.id
                            data-status=items.status
                            button-change-status
                          )
                            i.fas.fa-circle
                            | Hoạt động
                        else
                          a.badge-status.badge-status-danger.text-decoration-none(
                            href="javascript:;"
                            data-id=items.id
                            data-status=items.status
                            button-change-status
                          )
                            i.fas.fa-circle
                            | Dừng hoạt động
                      td.text-center
                        .action-btn-group
                          if(role.permissions.includes("products_edit"))
                            a.btn-action.btn-action-edit(href=`${prefixAdmin}/products/edit/${items.id}`, title="Chỉnh sửa")
                              i.fas.fa-pen
                          a.btn-action.btn-action-detail(
                            href=`${prefixAdmin}/products/detail/${items.id}`
                            title="Xem chi tiết"
                          )
                            i.fas.fa-eye
                          if(role.permissions.includes("products_delete"))
                            button(class= "btn-action btn-action-delete" data-id = items.id button-delete title="Xóa sản phẩm")
                              i.fas.fa-trash-alt
                else
                  tr
                    td.text-center.py-4(colspan="6")
                      .text-muted Không tìm thấy sản phẩm nào.
      +pagination(pagination)

      form(
        action = "",
        method = "POST",
        id = "form-change-status",
        data-path = `${prefixAdmin}/products/change-status`
      )

      form(
        action = "",
        method = "POST",
        id = "form-delete-item",
        data-path = `${prefixAdmin}/products/delete`
      )

      script(src="/admin/js/product.js")
