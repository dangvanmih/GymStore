extends ../../layouts/default.pug
include ../../mixins/filterStatus.pug
include ../../mixins/search.pug
append style
  link(rel="stylesheet" href="/admin/css/product.css")

block main
  .container-fluid.p-0
    //- Header trang
    .d-flex.justify-content-between.align-items-center.mb-2
      div
        h3.page-title Danh sách sản phẩm
        p.text-muted.mb-0 Quản lý danh mục, giá bán và trạng thái kho hàng.
      a.btn.btn-custom.btn-sm.d-inline-flex.align-items-center(href="/admin/products/create")
        i.fas.fa-plus.mr-2
        span Thêm sản phẩm

    //- Wrapper Card cho bảng

    .card.mb-3 
      .card-header Bộ lọc và tìm kiếm 
      .cpn-search-filter.card-body
        .row.align-items-center
          .col-6
            +filter-Status(filterStatus)
          .col-6
            +search(keyword)
    .card.border-0.shadow-sm.rounded-3
      .card-body.p-0
        .table-responsive
          table.table.table-hover.align-middle.mb-0.custom-enterprise-table
            thead
              tr
                th.text-center(style="width: 60px;") STT
                th(style="width: 100px;") Hình ảnh
                th Tiêu đề sản phẩm
                th.text-end(style="width: 140px;") Giá bán
                th.text-center(style="width: 150px;") Trạng thái
                th.text-center(style="width: 130px;") Thao tác
            tbody
              if (products && products.length > 0)
                each items, index in products
                  tr
                    td.text-center.fw-medium.text-secondary #{index + 1}
                    td
                      .product-img-wrapper
                        img.product-img(src=items.thumbnail alt=items.title)
                    td
                      .fw-semibold.text-dark.product-title #{items.title}
                      small.text-muted.d-block ID: #{items._id || 'PROD-' + (index + 1)}
                    td.text-end
                      span.fw-bold #{items.price.toLocaleString('vi-VN')} đ
                    td.text-center
                      if items.status == 'active'
                        span.badge-status.badge-status-success
                          i.fas.fa-circle
                          | Hoạt động
                      else
                        span.badge-status.badge-status-danger
                          i.fas.fa-circle
                          | Dừng hoạt động
                    td.text-center
                      .action-btn-group
                        a.btn-action.btn-action-edit(href=`/admin/products/edit/${items._id}`, title="Chỉnh sửa")
                          i.fas.fa-pen
                        a.btn-action.btn-action-delete(href=`/admin/products/delete/${items._id}`, title="Xóa sản phẩm")
                          i.fas.fa-trash-alt
              else
                tr
                  td.text-center.py-4(colspan="6")
                    .text-muted Không tìm thấy sản phẩm nào.
    .card-footer.py-3.border-0
      nav(aria-label="Product list pagination")
        ul.pagination.pagination-sm.justify-content-end.mb-0

          //- Nút Lùi (Previous)
          li(class=`page-item ${pagination.currentPage <= 1 ? 'disabled' : ''}`)
            button(
              class="page-link"
              button-pagination=(pagination.currentPage - 1)
              disabled=(pagination.currentPage <= 1)
            )
              i.fas.fa-chevron-left

          //- Nút nhảy nhanh về TRANG 1 nếu startPage > 1
          if (pagination.startPage > 1)
            li.page-item
              button.page-link(button-pagination=1) 1
            if (pagination.startPage > 2)
              li.page-item.disabled
                span.page-link ...

          //- Dãy 3-4 trang linh hoạt xung quanh trang hiện tại
          - for (let i = pagination.startPage; i <= pagination.endPage; i++)
            li(class=`page-item ${i === pagination.currentPage ? 'active' : ''}`)
              button(class="page-link" button-pagination=i) #{i}

          //- Nút nhảy nhanh tới TRANG CUỐI nếu endPage < totalPages
          if (pagination.endPage < pagination.totalPages)
            if (pagination.endPage < pagination.totalPages - 1)
              li.page-item.disabled
                span.page-link ...
            li.page-item
              button.page-link(button-pagination=pagination.totalPages) #{pagination.totalPages}

          //- Nút Tiến (Next)
          li(class=`page-item ${pagination.currentPage >= pagination.totalPages ? 'disabled' : ''}`)
            button(
              class="page-link"
              button-pagination=(pagination.currentPage + 1)
              disabled=(pagination.currentPage >= pagination.totalPages)
            )
              i.fas.fa-chevron-right