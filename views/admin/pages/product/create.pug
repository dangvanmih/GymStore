extends ../../layouts/default.pug
include ../../mixins/alert.pug

append style
  link(rel="stylesheet" href="/admin/css/product-create.css")

block main
  +alert-error(5000)

  .container-fluid.p-0.create-product-wrapper
    //- Header trang
    .d-flex.justify-content-between.align-items-center.mb-4
      div
        h3.page-title.mb-1 Thêm mới sản phẩm
        p.text-muted.mb-0 Nhập thông tin chi tiết để khởi tạo sản phẩm mới vào hệ thống.
      a.btn.btn-outline-secondary.btn-sm.d-inline-flex.align-items-center(href=`${prefixAdmin}/products`)
        i.fas.fa-arrow-left.me-2.mr-2
        span Quay lại danh sách

    //- Form tạo sản phẩm
    form(
      action=`${prefixAdmin}/products/create`
      method="POST"
      enctype="multipart/form-data"
      id="form-create-product"
    )
      .row.g-4
        //- Cột trái: Thông tin chính
        .col-lg-8
          .card.border-0.shadow-sm.mb-4
            .card-header.bg-transparent.border-bottom.py-3
              h5.card-title.mb-0.fw-semibold Thông tin chung
            .card-body
              //- Tiêu đề
              .mb-3
                label.form-label.fw-medium(for="title") Tiêu đề sản phẩm #[span.text-danger *]
                input.form-control.form-control-dark(
                  type="text"
                  name="title"
                  id="title"
                  placeholder="Ví dụ: Áo Sơ Mi Degrey Black Pattern..."
                  required
                )

              //- Mô tả
              .mb-3
                label.form-label.fw-medium(for="desc") Mô tả sản phẩm
                textarea.form-control.form-control-dark(
                  name="description"
                  rows="5"
                  id="desc"
                  placeholder="Nhập mô tả chi tiết về chất liệu, kiểu dáng, hướng dẫn bảo quản..."
                )

          //- Card Giá & Kho hàng
          .card.border-0.shadow-sm
            .card-header.bg-transparent.border-bottom.py-3
              h5.card-title.mb-0.fw-semibold Giá & Dữ liệu kho
            .card-body
              .row.g-3
                .col-md-4
                  label.form-label.fw-medium(for="price") Giá bán (VNĐ) #[span.text-danger *]
                  .input-group.input-group-dark
                    input#price.form-control.form-control-dark(
                      type="number"
                      name="price"
                      value="0"
                      min="0"
                      required
                    )
                    span.input-group-text đ

                .col-md-4
                  label.form-label.fw-medium(for="discountPercentage") % Giảm giá
                  .input-group.input-group-dark
                    input#discountPercentage.form-control.form-control-dark(
                      type="number"
                      name="discountPercentage"
                      value="0"
                      min="0"
                      max="100"
                    )
                    span.input-group-text %

                .col-md-4
                  label.form-label.fw-medium(for="stock") Số lượng trong kho #[span.text-danger *]
                  input#stock.form-control.form-control-dark(
                    type="number"
                    name="stock"
                    value="1"
                    min="1"
                    required
                  )

        //- Cột phải: Hình ảnh & Cấu hình xuất bản
        .col-lg-4
          //- Card Ảnh đại diện
          .card.border-0.shadow-sm.mb-4
            .card-header.bg-transparent.border-bottom.py-3
              h5.card-title.mb-0.fw-semibold Hình ảnh sản phẩm
            .card-body
              .upload-image-wrapper(upload-image)
                label.form-label.fw-medium(for="thumbnail") Chọn ảnh đại diện
                input#thumbnail.form-control-file.form-control-dark.mb-3(
                  type="file"
                  name="thumbnail"
                  accept="image/*"
                  upload-image-input
                )
                .upload-image-preview.text-center.p-3
                  .position-relative.d-inline-block(upload-preview-container)
                    img(
                      src=""
                      alt="Preview"
                      upload-image-preview
                      class="img-fluid rounded d-none"
                      style="max-height: 200px; object-fit: contain;"
                    )
                    //- Nút gỡ ảnh (Ban đầu ẩn đi bằng class d-none)
                    button.btn.btn-sm.btn-danger.rounded-circle.position-absolute.top-0.end-0.m-2.d-none(
                      type="button"
                      upload-image-remove
                      title="Gỡ ảnh"
                      style="width: 32px; height: 32px; padding: 0; line-height: 32px; z-index: 5;"
                    )
                      i.fas.fa-times
                  .upload-placeholder(upload-placeholder)
                    i.fas.fa-cloud-upload-alt.fa-2x.text-muted.mb-2
                    p.small.text-muted.mb-0 Kéo thả hoặc bấm để chọn tệp hình ảnh

          //- Card Trạng thái & Vị trí
          .card.border-0.shadow-sm.mb-4
            .card-header.bg-transparent.border-bottom.py-3
              h5.card-title.mb-0.fw-semibold Thiết lập hiển thị
            .card-body
              //- Vị trí
              .mb-3
                label.form-label.fw-medium(for="position") Vị trí hiển thị
                input#position.form-control.form-control-dark(
                  type="number"
                  name="position"
                  placeholder="Tự động tăng nếu để trống"
                  min="1"
                )
                small.text-muted Tự động xếp cuối danh sách nếu không nhập.

              //- Trạng thái
              .mb-3
                label.form-label.fw-medium.d-block Trạng thái hoạt động
                .form-check.form-check-inline
                  input#statusActive.form-check-input.custom-radio(
                    type="radio"
                    name="status"
                    value="active"
                    checked
                  )
                  label.form-check-label(for="statusActive") Hoạt động
                .form-check.form-check-inline
                  input#statusInActive.form-check-input.custom-radio(
                    type="radio"
                    name="status"
                    value="inactive"
                  )
                  label.form-check-label(for="statusInActive") Dừng hoạt động

          //- Nút Submit Form
          .d-grid.gap-2
            button.btn.btn-custom.btn-submit-create.btn-lg(type="submit")
              i.fas.fa-save.me-2.mr-2
              span Tạo mới sản phẩm

  script(src="/admin/js/product.js")