link(rel="stylesheet", href="/admin/css/header.css")

header.header-admin
  //- Left Section: Nút 3 gạch (Mobile Toggle) & Logo
  .header-logo.d-flex.align-items-center.gap-2
    button#sidebarToggle.mobile-menu-toggle(type="button" title="Mở/Đóng Menu")
      i.fas.fa-bars
    
    //- a(href="/admin/dashboard")
    //-   img(src="/admin/images/logo.png", alt="Logo" style='height:60px; object-fit: contain;')

  //- Actions & Profile (Giữ nguyên 100% logic cũ)
  .header-actions
    button.icon-btn.position-relative(type="button", title="Notifications")
      i.far.fa-bell
      span.notif-dot

    .user-profile.dropdown
      a.dropdown-toggle(href="#", id="userDropdown", data-toggle="dropdown", aria-haspopup="true", aria-expanded="false")
        img.avatar(src="https://ui-avatars.com/api/?name=Spencer&background=6366f1&color=fff", alt="Spencer")
        .user-info
          span.name Spencer
          span.role Administrator

      .dropdown-menu.dropdown-menu-right.shadow-lg
        a.dropdown-item(href=`${prefixAdmin}/profile`)
          i.fas.fa-user.mr-2
          | Profile
        a.dropdown-item(href=`${prefixAdmin}/setting`)
          i.fas.fa-sliders-h.mr-2
          | Settings
        .dropdown-divider
        a.dropdown-item.text-danger(href=`${prefixAdmin}/auth/logout`)
          i.fas.fa-sign-out-alt.mr-2
          | Logout