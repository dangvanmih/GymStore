link(rel="stylesheet" href="/admin/css/sider.css")
aside.sider
  //- Logo & Toggle Button
  .sider-header
    a.logo-brand(href=`${prefixAdmin}/dashboard`)
      .logo-icon
        img(src="/admin/images/short-icon.webp" alt="DEGREY Logo" style='height:36px; object-fit: contain; border-radius: 40%;')
      span.logo-text DEGREY

    button#sidebarToggle.toggle-btn(type="button" title="Đóng/Mở Menu")
      i.fas.fa-bars-staggered

  //- Menu Items
  .sider-body
    .menu-group-title OVERVIEW
    ul.nav-menu
      li.nav-item
        a.nav-link(href=`${prefixAdmin}/dashboard`)
          i.fas.fa-th-large
          span Dashboard
      li.nav-item
        a.nav-link(href=`${prefixAdmin}/analytics`)
          i.fas.fa-chart-line
          span Analytics

    .menu-group-title MANAGEMENT
    ul.nav-menu
      if(role.permissions.includes("products_view"))
        li.nav-item
          a.nav-link(href=`${prefixAdmin}/products`)
            i.fas.fa-boxes
            span Products
      if(role.permissions.includes("products-category_view"))
        li.nav-item
          a.nav-link(href=`${prefixAdmin}/categories`)
            i.fas.fa-folder
            span Categories
      li.nav-item
        a.nav-link(href=`${prefixAdmin}/orders`)
          i.fas.fa-shopping-cart
          span Orders
      if(role.permissions.includes("accounts-view"))
        li.nav-item
          a.nav-link(href=`${prefixAdmin}/accounts`)
            i.fas.fa-users
            span Users
      if(role.permissions.includes("roles_view"))
        li.nav-item
          a.nav-link(href=`${prefixAdmin}/roles`)
            i.fas.fa-shield-alt
            span Roles
      if(role.permissions.includes("roles_permission"))
        li.nav-item
          a.nav-link(href=`${prefixAdmin}/roles/permissions`)
            i.fas.fa-key
            span Permissions
    .menu-group-title SYSTEM
    ul.nav-menu
      li.nav-item
        a.nav-link(href="/admin/settings")
          i.fas.fa-cog
          span Settings