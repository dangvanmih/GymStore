link(rel="stylesheet" href="/admin/css/sider.css?v=4")
//- Lớp phủ nền mờ khi mở menu trên mobile
.sider-backdrop
aside.sider
  //- Logo & Toggle Button
  .sider-header
    a.logo-brand(href=`${prefixAdmin}/dashboard`)
      .logo-icon
        img(src="/admin/images/logo-web.png" alt="DEGREY Logo" style='height:30px; object-fit: contain;')
      span.logo-text DEGREY

    button#sidebarToggle.toggle-btn(type="button" title="Đóng/Mở Menu")
      svg.menu-icon(viewBox="0 0 24 24" aria-hidden="true")
        path(d="M4 6h16M4 12h16M4 18h16")

  //- Menu Items
  .sider-body
    .menu-group-title BÁO CÁO & TỔNG QUAN
    ul.nav-menu
      li.nav-item
        a.nav-link(href=`${prefixAdmin}/dashboard`)
          svg.menu-icon(viewBox="0 0 24 24" aria-hidden="true")
            rect(x="4" y="4" width="6" height="6" rx="1")
            rect(x="14" y="4" width="6" height="6" rx="1")
            rect(x="4" y="14" width="6" height="6" rx="1")
            rect(x="14" y="14" width="6" height="6" rx="1")
          span Tổng quan
      li.nav-item
        a.nav-link(href=`${prefixAdmin}/analytics`)
          svg.menu-icon(viewBox="0 0 24 24" aria-hidden="true")
            path(d="M4 19V5M4 19h16M7 15l4-4 3 2 5-6")
            path(d="M16 7h3v3")
          span Báo cáo doanh thu

    .menu-group-title QUẢN LÝ
    ul.nav-menu
      if(role.permissions.includes("products_view"))
        li.nav-item
          a.nav-link(href=`${prefixAdmin}/products`)
            svg.menu-icon(viewBox="0 0 24 24" aria-hidden="true")
              path(d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z")
              path(d="m4.5 7.7 7.5 4.2 7.5-4.2M12 12v9M8 5.2l8 4.5")
            span Sản phẩm
      if(role.permissions.includes("inventory_view"))
        li.nav-item
          a.nav-link(href=`${prefixAdmin}/inventory`)
            svg.menu-icon(viewBox="0 0 24 24" aria-hidden="true")
              path(d="M3 10 12 4l9 6v10H3V10Z")
              path(d="M7 20v-6h10v6M7 10h.01M12 10h.01M17 10h.01")
            span Tồn kho
      if(role.permissions.includes("products-category_view"))
        li.nav-item
          a.nav-link(href=`${prefixAdmin}/categories`)
            svg.menu-icon(viewBox="0 0 24 24" aria-hidden="true")
              path(d="M3 7a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z")
            span Danh mục
      if(role.permissions.includes("orders_view"))
        li.nav-item
          a.nav-link(href=`${prefixAdmin}/orders`)
            svg.menu-icon(viewBox="0 0 24 24" aria-hidden="true")
              path(d="M3 4h2l2.5 11h10L20 8H6")
              circle(cx="9" cy="19" r="1")
              circle(cx="17" cy="19" r="1")
            span Đơn hàng
            b.menu-badge(
              aria-label=`${pendingOrdersCount} đơn chờ xác nhận`
              hidden=(pendingOrdersCount || 0) < 1
            )= pendingOrdersCount || 0
      if(role.permissions.includes("accounts-view"))
        li.nav-item
          a.nav-link(href=`${prefixAdmin}/accounts`)
            svg.menu-icon(viewBox="0 0 24 24" aria-hidden="true")
              circle(cx="9" cy="8" r="3")
              path(d="M3.5 20v-1a5.5 5.5 0 0 1 11 0v1M16 5.5a3 3 0 0 1 0 5.8M17 14a5 5 0 0 1 3.5 4.8V20")
            span Tài khoản
      if(role.permissions.includes("roles_view"))
        li.nav-item
          a.nav-link(href=`${prefixAdmin}/roles`)
            svg.menu-icon(viewBox="0 0 24 24" aria-hidden="true")
              path(d="M12 3 20 6v5c0 5-3.4 8-8 10-4.6-2-8-5-8-10V6l8-3Z")
              path(d="m9 12 2 2 4-4")
            span Vai trò
      if(role.permissions.includes("roles_permission"))
        li.nav-item
          a.nav-link(href=`${prefixAdmin}/roles/permissions`)
            svg.menu-icon(viewBox="0 0 24 24" aria-hidden="true")
              circle(cx="8" cy="15" r="4")
              path(d="m11 12 8-8 2 2-2 2 2 2-3 3-2-2-2 2")
            span Phân quyền
    .menu-group-title HỆ THỐNG
    ul.nav-menu
      if(role.permissions.includes("settings_view"))
        li.nav-item
          a.nav-link(href="/admin/settings")
            svg.menu-icon(viewBox="0 0 24 24" aria-hidden="true")
              path(d="M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z")
              path(d="m19.4 15 .1.1a1.7 1.7 0 0 1-2.4 2.4L17 17.4a7.8 7.8 0 0 1-2.2.9v.2a1.7 1.7 0 0 1-3.4 0v-.2a7.8 7.8 0 0 1-2.2-.9l-.1.1a1.7 1.7 0 0 1-2.4-2.4l.1-.1a7.8 7.8 0 0 1-.9-2.2h-.2a1.7 1.7 0 0 1 0-3.4h.2a7.8 7.8 0 0 1 .9-2.2l-.1-.1a1.7 1.7 0 0 1 2.4-2.4l.1.1a7.8 7.8 0 0 1 2.2-.9v-.2a1.7 1.7 0 0 1 3.4 0v.2a7.8 7.8 0 0 1 2.2.9l.1-.1a1.7 1.7 0 0 1 2.4 2.4l-.1.1a7.8 7.8 0 0 1 .9 2.2h.2a1.7 1.7 0 0 1 0 3.4h-.2a7.8 7.8 0 0 1-.9 2.2Z")
            span Cài đặt

